/* MediaMTX VMS Client v2.1 - Professional Dark Theme */
/* Modern VMS Design with Gradients and Glassmorphism */

/* ═══════════════════════════════════════════════════════════════
   COLOR PALETTE
   
   Primary Gradient: #667eea → #764ba2 (Purple-Violet)
   Accent:          #00d4aa (Cyan-Teal)
   Success:         #10b981 (Emerald)
   Warning:         #f59e0b (Amber)
   Error:           #ef4444 (Red)
   
   Background Dark:  #0d1117 (Deep Black)
   Background Mid:   #161b22 (Charcoal)
   Background Light: #21262d (Slate)
   
   Text Primary:     #f0f6fc (White)
   Text Secondary:   #8b949e (Gray)
   
   Border:           #30363d (Dark Gray)
   Border Hover:     #58a6ff (Blue)
═══════════════════════════════════════════════════════════════ */

/* Global Styles */
* {
    font-family: "Segoe UI", "Inter", -apple-system, Arial, sans-serif;
    font-size: 10pt;
    color: #f0f6fc;
    outline: none;
}

QMainWindow {
    background-color: #0d1117;
}

QWidget {
    background-color: transparent;
    color: #f0f6fc;
}

/* ═══════════════════════════════════════════════════════════════
   TOOLBAR - Gradient Header
═══════════════════════════════════════════════════════════════ */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #161b22, stop:0.5 #1c232d, stop:1 #161b22);
    border: none;
    border-bottom: 1px solid #30363d;
    spacing: 6px;
    padding: 8px 12px;
    min-height: 48px;
}

QToolBar::separator {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.5 #30363d, stop:1 transparent);
    width: 1px;
    margin: 8px 12px;
}

/* ═══════════════════════════════════════════════════════════════
   BUTTONS - Modern with hover glow
═══════════════════════════════════════════════════════════════ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #21262d, stop:1 #161b22);
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 16px;
    color: #f0f6fc;
    min-height: 28px;
    font-weight: 500;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2d333b, stop:1 #21262d);
    border-color: #58a6ff;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161b22, stop:1 #21262d);
}

QPushButton:disabled {
    background-color: #161b22;
    color: #484f58;
    border-color: #21262d;
}

/* Primary Action Button - Gradient */
QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7b8eef, stop:1 #8860b0);
}

QPushButton[primary="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5567d5, stop:1 #6a4299);
}

/* Success Button */
QPushButton[success="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #10b981, stop:1 #059669);
    color: #ffffff;
    border: none;
}

/* Danger Button */
QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ef4444, stop:1 #dc2626);
    color: #ffffff;
    border: none;
}

/* ═══════════════════════════════════════════════════════════════
   TOOL BUTTONS
═══════════════════════════════════════════════════════════════ */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 8px 12px;
    color: #f0f6fc;
    font-weight: 500;
}

QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(88, 166, 255, 0.15), stop:1 rgba(88, 166, 255, 0.05));
    border-color: #58a6ff;
}

QToolButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(88, 166, 255, 0.25), stop:1 rgba(88, 166, 255, 0.1));
}

/* ═══════════════════════════════════════════════════════════════
   INPUT FIELDS - Glassmorphism style
═══════════════════════════════════════════════════════════════ */
QLineEdit {
    background-color: rgba(22, 27, 34, 0.8);
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 12px;
    color: #f0f6fc;
    selection-background-color: #58a6ff;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #58a6ff;
    background-color: rgba(22, 27, 34, 0.95);
}

QLineEdit:disabled {
    background-color: rgba(13, 17, 23, 0.5);
    color: #484f58;
    border-color: #21262d;
}

QLineEdit::placeholder {
    color: #484f58;
}

/* ═══════════════════════════════════════════════════════════════
   COMBO BOX
═══════════════════════════════════════════════════════════════ */
QComboBox {
    background-color: rgba(22, 27, 34, 0.8);
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 12px;
    color: #f0f6fc;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #58a6ff;
}

QComboBox:focus {
    border-color: #58a6ff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    padding-right: 8px;
}

QComboBox::down-arrow {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8b949e;
}

QComboBox::down-arrow:hover {
    border-top-color: #f0f6fc;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    selection-background-color: #58a6ff;
    color: #f0f6fc;
    padding: 4px;
}

/* ═══════════════════════════════════════════════════════════════
   SPIN BOX
═══════════════════════════════════════════════════════════════ */
QSpinBox, QDoubleSpinBox {
    background-color: rgba(22, 27, 34, 0.8);
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 12px;
    color: #f0f6fc;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #58a6ff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #8b949e;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8b949e;
}

/* ═══════════════════════════════════════════════════════════════
   CHECKBOX & RADIO - Modern toggle style
═══════════════════════════════════════════════════════════════ */
QCheckBox {
    spacing: 10px;
    color: #f0f6fc;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #30363d;
    border-radius: 4px;
    background-color: rgba(22, 27, 34, 0.8);
}

QCheckBox::indicator:hover {
    border-color: #58a6ff;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:1 #764ba2);
    border: none;
}

QRadioButton {
    spacing: 10px;
    color: #f0f6fc;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #30363d;
    border-radius: 10px;
    background-color: rgba(22, 27, 34, 0.8);
}

QRadioButton::indicator:hover {
    border-color: #58a6ff;
}

QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:1 #764ba2);
    border: 4px solid #0d1117;
}

/* ═══════════════════════════════════════════════════════════════
   SLIDER - Gradient track
═══════════════════════════════════════════════════════════════ */
QSlider::groove:horizontal {
    height: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #21262d, stop:1 #30363d);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:1 #764ba2);
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #7b8eef, stop:1 #8860b0);
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
    border-radius: 3px;
}

/* ═══════════════════════════════════════════════════════════════
   PROGRESS BAR - Animated gradient
═══════════════════════════════════════════════════════════════ */
QProgressBar {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    text-align: center;
    color: #f0f6fc;
    height: 24px;
    font-weight: 600;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:0.5 #00d4aa, stop:1 #764ba2);
    border-radius: 5px;
}

/* ═══════════════════════════════════════════════════════════════
   TAB WIDGET - Underline style
═══════════════════════════════════════════════════════════════ */
QTabWidget::pane {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 12px 20px;
    margin-right: 4px;
    color: #8b949e;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #f0f6fc;
    border-bottom: 3px solid;
    border-image: linear-gradient(to right, #667eea, #764ba2) 1;
}

QTabBar::tab:hover:!selected {
    color: #f0f6fc;
    border-bottom-color: #30363d;
}

/* ═══════════════════════════════════════════════════════════════
   TREE WIDGET - Glassmorphism panel
═══════════════════════════════════════════════════════════════ */
QTreeWidget, QTreeView {
    background-color: rgba(22, 27, 34, 0.7);
    border: 1px solid #30363d;
    border-radius: 8px;
    alternate-background-color: rgba(33, 38, 45, 0.5);
    selection-background-color: rgba(88, 166, 255, 0.3);
    outline: none;
    padding: 4px;
}

QTreeWidget::item, QTreeView::item {
    padding: 8px 4px;
    color: #f0f6fc;
    border: none;
    border-radius: 4px;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: rgba(48, 54, 61, 0.5);
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.4), stop:1 rgba(118, 75, 162, 0.3));
    color: #ffffff;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    border-image: none;
    image: none;
}

/* ═══════════════════════════════════════════════════════════════
   TABLE WIDGET
═══════════════════════════════════════════════════════════════ */
QTableWidget, QTableView {
    background-color: rgba(22, 27, 34, 0.7);
    border: 1px solid #30363d;
    border-radius: 8px;
    gridline-color: #21262d;
    selection-background-color: rgba(88, 166, 255, 0.3);
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 8px;
    color: #f0f6fc;
    border: none;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: rgba(48, 54, 61, 0.5);
}

QTableWidget::item:selected, QTableView::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.4), stop:1 rgba(118, 75, 162, 0.3));
    color: #ffffff;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #21262d, stop:1 #161b22);
    border: none;
    border-right: 1px solid #30363d;
    border-bottom: 1px solid #30363d;
    padding: 10px 8px;
    color: #8b949e;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 9pt;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2d333b, stop:1 #21262d);
    color: #f0f6fc;
}

/* ═══════════════════════════════════════════════════════════════
   SCROLL BARS - Minimal modern style
═══════════════════════════════════════════════════════════════ */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    min-height: 40px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::handle:vertical:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    min-width: 40px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484f58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ═══════════════════════════════════════════════════════════════
   MENU BAR
═══════════════════════════════════════════════════════════════ */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161b22, stop:1 #0d1117);
    color: #f0f6fc;
    border-bottom: 1px solid #30363d;
    padding: 2px 0;
}

QMenuBar::item {
    padding: 8px 16px;
    background-color: transparent;
    border-radius: 4px;
    margin: 2px 4px;
}

QMenuBar::item:selected {
    background-color: rgba(48, 54, 61, 0.8);
}

QMenuBar::item:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.5), stop:1 rgba(118, 75, 162, 0.5));
}

/* ═══════════════════════════════════════════════════════════════
   MENU - Glassmorphism dropdown
═══════════════════════════════════════════════════════════════ */
QMenu {
    background-color: rgba(22, 27, 34, 0.95);
    border: 1px solid #30363d;
    border-radius: 8px;
    color: #f0f6fc;
    padding: 8px 4px;
}

QMenu::item {
    padding: 10px 24px 10px 16px;
    border-radius: 4px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.5), stop:1 rgba(118, 75, 162, 0.5));
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent, stop:0.5 #30363d, stop:1 transparent);
    margin: 6px 12px;
}

QMenu::indicator {
    width: 18px;
    height: 18px;
    margin-left: 8px;
}

/* ═══════════════════════════════════════════════════════════════
   STATUS BAR - Gradient accent
═══════════════════════════════════════════════════════════════ */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:0.5 #764ba2, stop:1 #667eea);
    color: #ffffff;
    border-top: none;
    padding: 6px 16px;
    font-weight: 500;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #ffffff;
    background-color: transparent;
    padding: 0 12px;
}

/* ═══════════════════════════════════════════════════════════════
   DOCK WIDGET - Panel style
═══════════════════════════════════════════════════════════════ */
QDockWidget {
    background-color: transparent;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #21262d, stop:1 #161b22);
    padding: 10px 12px;
    border: 1px solid #30363d;
    border-bottom: 2px solid;
    border-image: linear-gradient(to right, #667eea, #764ba2) 1;
    color: #f0f6fc;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 9pt;
    letter-spacing: 1px;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 4px;
    border-radius: 4px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: rgba(48, 54, 61, 0.8);
}

/* ═══════════════════════════════════════════════════════════════
   DIALOG
═══════════════════════════════════════════════════════════════ */
QDialog {
    background-color: #0d1117;
}

/* ═══════════════════════════════════════════════════════════════
   GROUP BOX - Glassmorphism container
═══════════════════════════════════════════════════════════════ */
QGroupBox {
    background-color: rgba(22, 27, 34, 0.5);
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    color: #f0f6fc;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 4px 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 126, 234, 0.3), stop:1 rgba(118, 75, 162, 0.3));
    border-radius: 4px;
    color: #f0f6fc;
}

/* ═══════════════════════════════════════════════════════════════
   LABELS
═══════════════════════════════════════════════════════════════ */
QLabel {
    background-color: transparent;
    color: #f0f6fc;
}

QLabel[heading="true"] {
    font-size: 14pt;
    font-weight: 700;
    color: #ffffff;
}

QLabel[subheading="true"] {
    font-size: 11pt;
    font-weight: 600;
    color: #8b949e;
}

/* ═══════════════════════════════════════════════════════════════
   TOOLTIP - Modern floating
═══════════════════════════════════════════════════════════════ */
QToolTip {
    background-color: rgba(22, 27, 34, 0.95);
    border: 1px solid #30363d;
    color: #f0f6fc;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 9pt;
}

/* ═══════════════════════════════════════════════════════════════
   SPLITTER
═══════════════════════════════════════════════════════════════ */
QSplitter::handle {
    background-color: #30363d;
}

QSplitter::handle:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ═══════════════════════════════════════════════════════════════
   VIDEO WIDGET - Professional monitoring style
═══════════════════════════════════════════════════════════════ */
QLabel[videoWidget="true"] {
    background-color: #000000;
    border: 2px solid #30363d;
    border-radius: 6px;
}

QLabel[videoWidget="true"][status="connected"] {
    border-color: #10b981;
    border-width: 2px;
}

QLabel[videoWidget="true"][status="connecting"] {
    border-color: #f59e0b;
    border-width: 2px;
}

QLabel[videoWidget="true"][status="reconnecting"] {
    border-color: #f59e0b;
    border-width: 2px;
}

QLabel[videoWidget="true"][status="error"] {
    border-color: #ef4444;
    border-width: 2px;
}

QLabel[videoWidget="true"][status="recording"] {
    border-color: #ef4444;
    border-width: 3px;
}

QLabel[videoWidget="true"]:hover {
    border-width: 3px;
    border-color: #58a6ff;
}

/* ═══════════════════════════════════════════════════════════════
   TEXT EDIT / PLAIN TEXT EDIT
═══════════════════════════════════════════════════════════════ */
QTextEdit, QPlainTextEdit {
    background-color: rgba(22, 27, 34, 0.8);
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px;
    color: #f0f6fc;
    selection-background-color: #58a6ff;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #58a6ff;
}

/* ═══════════════════════════════════════════════════════════════
   MESSAGE BOX
═══════════════════════════════════════════════════════════════ */
QMessageBox {
    background-color: #0d1117;
}

QMessageBox QLabel {
    color: #f0f6fc;
    font-size: 10pt;
}

/* ═══════════════════════════════════════════════════════════════
   CALENDAR WIDGET (if used)
═══════════════════════════════════════════════════════════════ */
QCalendarWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #f0f6fc;
    font-weight: 600;
    border: none;
    padding: 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: rgba(48, 54, 61, 0.8);
    border-radius: 4px;
}

QCalendarWidget QSpinBox {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
}

QCalendarWidget QTableView {
    background-color: #161b22;
    selection-background-color: rgba(102, 126, 234, 0.5);
    alternate-background-color: #21262d;
}

/* ═══════════════════════════════════════════════════════════════
   SPECIAL UTILITY CLASSES
═══════════════════════════════════════════════════════════════ */

/* Accent text */
QLabel[accent="true"] {
    color: #00d4aa;
    font-weight: 600;
}

/* Warning text */
QLabel[warning="true"] {
    color: #f59e0b;
}

/* Error text */
QLabel[error="true"] {
    color: #ef4444;
}

/* Success text */
QLabel[success="true"] {
    color: #10b981;
}

/* Muted text */
QLabel[muted="true"] {
    color: #484f58;
}
